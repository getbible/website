{
  "name": "getbible-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/prepare.mjs && astro build && node scripts/verify.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "sync:apis": "node scripts/sync-apis.mjs"
  },
  "dependencies": {
    "astro": "7.3.2",
    "marked": "17.0.4",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": { "@astrojs/check": "0.9.9", "typescript": "5.9.3" }
}
